# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://interviewlab:interviewlab@localhost:5432/ai_interview_db?schema=public"

# Authentication
JWT_SECRET="your_secret_jwt_key_here"
JWT_EXPIRES_IN="24h"

# Redis Configuration (future job queues)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# Storage
STORAGE_PROVIDER="local"
UPLOAD_MAX_FILE_SIZE=5242880

# Microservice Integration
AGENT_SERVICE_URL="http://localhost:8000/api/v1"
ML_SERVICE_URL="http://localhost:8001/api/v1"
PYTHON_MICROSERVICE_URL="http://localhost:8000/api/v1"
PYTHON_SERVICE_API_KEY="internal_service_key_for_auth"
